<Window x:Class="DesktopFly.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopFly"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize">
  <Grid x:Name="Root" IsHitTestVisible="False">
    <Viewport3D x:Name="Viewport" ClipToBounds="False" />
    <Border x:Name="DebugPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="18" Padding="10,7" CornerRadius="7" Background="#C51A1D23"
            Visibility="Collapsed">
      <TextBlock x:Name="DebugText" Foreground="White" FontFamily="Consolas" FontSize="12" />
    </Border>
  </Grid>
</Window>
